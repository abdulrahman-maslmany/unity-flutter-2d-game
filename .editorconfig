# Top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files formatting & analyzer rules
[*.cs]
indent_size = 4
csharp_indent_braces = false
csharp_new_line_before_open_brace = all
csharp_preferred_modifier_order = public,private,protected,internal,static,readonly,virtual,override,abstract,sealed,async
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# Dart & YAML files
[*.{dart,yaml,yml}]
indent_size = 2

# Exclude auto-generated Unity Input System files from Roslyn & Linter debt metrics
[**/PlayerInputAction.cs]
generated_code = true
