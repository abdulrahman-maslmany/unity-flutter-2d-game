# Exclude auto-generated Unity input files from code analysis & metrics
Assets/Art/Characters/Player/PlayerInputAction.cs linguist-generated=true
**/PlayerInputAction.cs linguist-generated=true
*.inputactions linguist-generated=true

# Mark binary artifacts
*.aab binary
*.apk binary
*.unitypackage binary
# Exclude Unity meta files and lockfiles from statistics
*.meta -text -diff
*.lock linguist-generated=true
packages.lock.json linguist-generated=true
pubspec.lock linguist-generated=true
